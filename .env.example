# OpenAI Configuration
OPENAI_API_KEY=

# Google Gemini Configuration
GOOGLE_API_KEY=

# Model ids are NOT read from here. Models are configured per ROLE in
# application.yml under agentic.llm.models, so no class ever names a model id
# and swapping one is a deployment decision.

# Optional. Several hosts require an identifying User-Agent — Wikimedia answers
# 403 without one. A default is set in application.yml; override it here.
# TOOL_USER_AGENT=my-app/0.1 (me@example.com)

# ---------------------------------------------------------------------------
# Observability. Everything below is OPTIONAL — with none of it set, the
# application does not export a trace and does not open a connection.
#
# There are two independent destinations, matching the two compose profiles in
# compose.observability.yaml. Set one, the other, or both.
# ---------------------------------------------------------------------------

# (1) An OpenTelemetry collector — the Grafana side.
#     docker compose -f compose.observability.yaml --profile grafana up -d
#     Grafana is then on http://localhost:3001 (anonymous admin, local only).
# AGENTIC_OBSERVABILITY_OTLP_ENDPOINT=http://localhost:4318

# (2) A Langfuse instance directly. gRPC is not an option: Langfuse accepts
#     OTLP over HTTP only.
#     docker compose -f compose.observability.yaml --profile langfuse up -d
#     Langfuse is then on http://localhost:3000.
#
#     The compose file initialises Langfuse headlessly with exactly these two
#     keys, so they can be set here BEFORE the first boot rather than copied
#     out of the UI afterwards. Replace them for anything but a laptop.
# AGENTIC_OBSERVABILITY_LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-0000000000000000000000000000000000
# LANGFUSE_SECRET_KEY=sk-lf-0000000000000000000000000000000000
# AGENTIC_OBSERVABILITY_LANGFUSE_PUBLIC_KEY=${LANGFUSE_PUBLIC_KEY}
# AGENTIC_OBSERVABILITY_LANGFUSE_SECRET_KEY=${LANGFUSE_SECRET_KEY}

# Which environment a trace belongs to. Langfuse filters and alert rules key
# off it, and `default` is Langfuse's own default name.
# AGENTIC_ENVIRONMENT=local

# Span input and output carry the user's message, the system prompt and
# whatever a public API returned. Set to false to trace shapes and timings with
# no content at all.
# AGENTIC_CAPTURE_CONTENT=true

# Head sampling, applied at the root and inherited by every child.
# AGENTIC_TRACE_SAMPLE_RATE=1.0
